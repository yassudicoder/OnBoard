<?xml version="1.0" encoding="utf-8"?>
<!-- PARKED FEATURE (CLAUDE.md "Parked"): trip status (TripStatusFragment), the old Home tab of the trip-timeline
     plan. Reachable only when feature.tripTimeline=true (Profile > More). The trip at a glance for Aditi.
     Every trip detail on this screen is filled in from the saved plan (Room), the same data as the Trip tab:
       1. greeting + sync line ("Updated 22:16" / "Offline · showing your saved plan from 22:16");
       2. status card: on track / your plan changed / N things need your decision, with one button;
       3. trip card: title, summary and the first flight (departs, arrives, "Planned for 08:00 · 2 hours later");
       4. "Needs your decision" and "Changed for you": the same booking cards as the Trip tab;
       5. a "saved on this phone" note and a button to the full timeline.
     Before a plan is saved on the phone, a loading or error box (with Retry) replaces 2-5.
     Pull down to refresh. MainActivity keeps this screen clear of the system bars (edge-to-edge), so no insets here. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trip_status_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- 1. Greeting and sync line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/trip_status_greeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Good evening, Aditi" />

                    <!-- When offline, the code puts a "cloud off" icon in front of the text. -->
                    <TextView
                        android:id="@+id/trip_status_sync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Updated 22:16" />
                </LinearLayout>

                <!-- The traveller's initial. Decorative: the greeting already says the name. -->
                <TextView
                    android:id="@+id/trip_status_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="A" />
            </LinearLayout>

            <!-- Before a plan is saved: "Loading your trip…" with a spinner, or why it failed with Retry. -->
            <LinearLayout
                android:id="@+id/trip_status_state_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/trip_status_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <ImageView
                    android:id="@+id/trip_status_state_icon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_offline_24"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/trip_status_state_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="@string/trip_empty_loading_title" />

                <TextView
                    android:id="@+id/trip_status_state_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxWidth="480dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/trip_empty_loading_message" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_status_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="@string/trip_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The trip, once a plan is saved on the phone. -->
            <LinearLayout
                android:id="@+id/trip_status_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 2. Status card. Fill, text and icon colours are set in code from the trip's state. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/trip_status_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Decorative: the title next to it says the same. -->
                            <ImageView
                                android:id="@+id/trip_status_status_icon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@null"
                                tools:src="@drawable/ic_check_circle_24" />

                            <TextView
                                android:id="@+id/trip_status_status_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                tools:text="@string/home_state_on_track" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/trip_status_status_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="Next: Flight IJ 512 Mumbai to Bengaluru · Sun, 11 Oct, 08:00" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/trip_status_status_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            tools:text="@string/home_action_view_trip" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Trip card with the first flight. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/trip_status_trip_card"
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_trip_label"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/trip_status_trip_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Client visit: Mumbai to Bengaluru" />

                        <TextView
                            android:id="@+id/trip_status_trip_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Business trip · Sun, 11 Oct · 6 bookings" />

                        <com.google.android.material.divider.MaterialDivider
                            android:id="@+id/trip_status_flight_divider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" />

                        <!-- The flight. One big tap target: opens its details. -->
                        <LinearLayout
                            android:id="@+id/trip_status_flight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="48dp"
                            android:orientation="vertical"
                            android:paddingTop="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription="@string/type_flight"
                                    android:src="@drawable/ic_block_flight_24"
                                    app:tint="?attr/colorPrimary" />

                                <TextView
                                    android:id="@+id/trip_status_flight_title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Flight IJ 512 Mumbai to Bengaluru" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/home_departs"
                                        android:textAppearance="?attr/textAppearanceLabelMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/trip_status_departs_time"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="08:00" />

                                    <TextView
                                        android:id="@+id/trip_status_departs_day"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceBodySmall"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        tools:text="Sun, 11 Oct" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/home_arrives"
                                        android:textAppearance="?attr/textAppearanceLabelMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/trip_status_arrives_time"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        tools:text="09:45" />

                                    <TextView
                                        android:id="@+id/trip_status_arrives_day"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceBodySmall"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        tools:text="Sun, 11 Oct" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Status chip: the same rule and colours as the Trip tab (TripUi.styleStatusChip). -->
                            <TextView
                                android:id="@+id/trip_status_flight_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_status_chip"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                tools:text="@string/status_ok" />

                            <!-- "Planned for 08:00 · 2 hours later", only when the flight moved. Colours set in code. -->
                            <TextView
                                android:id="@+id/trip_status_flight_planned"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_status_chip"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:visibility="gone"
                                tools:drawableStart="@drawable/ic_schedule_24"
                                tools:text="Planned for 08:00 · 2 hours later"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/trip_status_flight_from"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="From Mumbai Airport T2 (BOM)" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Bookings that need a decision, then bookings that changed. Cards are added in code. -->
                <TextView
                    android:id="@+id/trip_status_needs_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/home_section_needs_you"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/trip_status_needs_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/trip_status_changed_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/home_section_changed"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/trip_status_changed_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 5. Saved on this phone + the full timeline. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_saved_offline_24"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/home_saved_offline"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_status_open_timeline"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:text="@string/home_open_timeline" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
