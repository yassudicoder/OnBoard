<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn over every Document Vault screen while the vault is locked (VaultScreen). It fills the screen and hides
     the documents underneath. Two versions, switched in code:
       - normal: "Vault locked" + Unlock (fingerprint, face or PIN);
       - the phone has no screen lock: an honest warning, a shortcut to Android's security settings, and a way in
         for this time only. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vault_cover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock_24"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/vault_cover_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/vault_locked_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/vault_cover_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/vault_locked_body"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vault_cover_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="@string/vault_unlock"
            app:icon="@drawable/ic_lock_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vault_cover_settings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/vault_open_security_settings"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vault_cover_skip"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/vault_open_without_lock"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
