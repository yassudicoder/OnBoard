<?xml version="1.0" encoding="utf-8"?>
<!-- Vault settings (VaultSettingsFragment):
       Security: lock on/off (turning it OFF needs fingerprint/face/PIN first), auto-lock time, screenshot blocking;
       Files: decrypt-test every file;
       Your data: lock now, delete the whole vault (full delete).
     Backup and the emergency-packet export come in a later phase. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/settings_security_heading"
            style="@style/Widget.SafarSaathi.ProfileSection"
            android:layout_marginTop="16dp"
            android:text="@string/vault_settings_security" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:minHeight="48dp"
            android:text="@string/vault_settings_lock"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="@string/vault_settings_lock_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/settings_auto_lock_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/vault_settings_auto_lock"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/settings_auto_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_auto_lock_1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_auto_lock_5"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_auto_lock_15"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_screenshots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/vault_settings_screenshots"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="@string/vault_settings_screenshots_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/settings_files_heading"
            style="@style/Widget.SafarSaathi.ProfileSection"
            android:text="@string/vault_settings_files" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_check"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:minHeight="48dp"
            android:text="@string/vault_settings_check"
            app:icon="@drawable/ic_check_circle_24" />

        <TextView
            android:id="@+id/settings_check_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settings_privacy_heading"
            style="@style/Widget.SafarSaathi.ProfileSection"
            android:text="@string/vault_settings_privacy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="@string/vault_settings_privacy_body"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_lock_now"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/vault_settings_lock_now"
            app:icon="@drawable/ic_lock_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_delete"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/vault_settings_delete"
            android:textColor="?attr/colorError"
            app:icon="@drawable/ic_delete_24"
            app:iconTint="?attr/colorError" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
