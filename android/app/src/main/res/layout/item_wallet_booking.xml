<?xml version="1.0" encoding="utf-8"?>
<!-- One booking reference of the saved trip (WalletFragment). Tap it to open the booking's details.
         [icon]  Flight IJ 512 Mumbai to Bengaluru
                 MockAir (demo airline) · booking ref K7Q2ZM
                 Sun, 11 Oct · 08:00–09:45 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/booking_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            app:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_block_flight_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/booking_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Flight IJ 512 Mumbai to Bengaluru" />

            <TextView
                android:id="@+id/booking_ref"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="MockAir (demo airline) · booking ref K7Q2ZM" />

            <TextView
                android:id="@+id/booking_when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Sun, 11 Oct · 08:00–09:45" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
