<?xml version="1.0" encoding="utf-8"?>
<!-- One line on the confirm screen about what the phone read: a tick for "read", a warning sign for "check this".
     The words say it too, so colour is never the only signal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/note_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@null"
        app:tint="?attr/colorPrimary"
        tools:src="@drawable/ic_check_circle_24" />

    <TextView
        android:id="@+id/note_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Read from the machine-readable lines (MRZ) at the bottom of the page." />
</LinearLayout>
