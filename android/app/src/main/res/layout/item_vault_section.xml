<?xml version="1.0" encoding="utf-8"?>
<!-- Heading of one group in a trip folder, e.g. "Kigali transit" / "Transit · 11 Nov 2026 to 12 Nov 2026",
     or "Passport" when grouped by type (then the subtitle is hidden). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="24dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Kigali transit" />

    <TextView
        android:id="@+id/section_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Transit · 11 Nov 2026 to 12 Nov 2026" />
</LinearLayout>
