<?xml version="1.0" encoding="utf-8"?>
<!-- Trip tab, "My trip" (TripFragment). From top to bottom:
       1. a red banner, only when something needs the traveller's decision (stays visible while scrolling);
       2. the timeline: a pull-to-refresh list whose first row is the trip header (title, summary, sync line);
       3. OR, instead of the list, an "empty state" when no plan is saved on the phone yet.
     MainActivity already keeps this screen clear of the system bars (edge-to-edge), so no insets here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. Attention banner. The whole card is one big tap target (opens the block's details). -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/trip_attention_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/status_needs_user_container"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Decorative: the text next to it says everything. -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning_24"
                app:tint="@color/status_needs_user_on_container" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/trip_attention_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/status_needs_user_on_container"
                    tools:text="1 thing needs your decision: Client meeting in Whitefield" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/trip_attention_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/status_needs_user_on_container" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 2. The timeline. Pull down to refresh. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/trip_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trip_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                tools:listitem="@layout/item_trip_block" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 3. Empty state. A ScrollView, so nothing is cut off with very large text or in landscape. -->
        <ScrollView
            android:id="@+id/trip_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_offline_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/trip_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="@string/trip_empty_error_title" />

                <TextView
                    android:id="@+id/trip_empty_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxWidth="480dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/trip_empty_error_network" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="@string/trip_retry" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
