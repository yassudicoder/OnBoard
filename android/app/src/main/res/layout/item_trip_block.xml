<?xml version="1.0" encoding="utf-8"?>
<!-- One booking (block) on the trip timeline (TripTimelineAdapter). Tap it to open its details.
     Everything is stacked vertically, so long titles, very large text and narrow screens still fit:
         [icon]  08:00–09:45                   [star, only on the anchor]
                 Flight IJ 512 Mumbai to Bengaluru
                 Mumbai Airport T2 (BOM)
                 [On track]   (status chip; colour set in code)
                 Planned for 08:00 · 2 hours later   (only when it moved from the original plan)
                 Moved to fit the new plan   (only when auto-adjusted) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/block_card"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Block type icon; its content description ("Flight", "Cab", ...) is set in code. -->
        <ImageView
            android:id="@+id/block_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            app:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_block_flight_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/block_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="08:00–09:45" />

            <TextView
                android:id="@+id/block_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Flight IJ 512 Mumbai to Bengaluru" />

            <TextView
                android:id="@+id/block_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Mumbai Airport T2 (BOM)" />

            <TextView
                android:id="@+id/block_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="@string/status_ok" />

            <TextView
                android:id="@+id/block_planned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Planned for 08:00 · 2 hours later"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/block_moved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/block_moved_label"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageView
            android:id="@+id/block_anchor"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/trip_anchor_description"
            android:src="@drawable/ic_anchor_star_24"
            android:visibility="gone"
            app:tint="?attr/colorTertiary"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
