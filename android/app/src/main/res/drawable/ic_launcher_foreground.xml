<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground layer of the app icon: a white airplane, tilted 45 degrees as if taking off.
     Airplane = Material Symbols "flight" (Apache License 2.0, github.com/google/material-design-icons).

     How it fits: an adaptive icon is 108 x 108 dp, but phones only promise to show a circle of 66 dp
     in the middle (the "safe zone"). The airplane's path is drawn on a 960-unit grid, so the group
     below shrinks it to 6.5% (about 52 dp long), turns it around the grid centre (480,480) and moves
     it so the tilted airplane sits in the middle of the icon: every point stays within 31 dp of the
     centre, inside the 33 dp safe-zone radius.
     Also used as the "monochrome" layer for Android 13+ themed icons (the phone recolours it). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="480"
        android:pivotY="480"
        android:rotation="45"
        android:scaleX="0.065"
        android:scaleY="0.065"
        android:translateX="-423"
        android:translateY="-429">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M340,880L340,820L420,760L420,540L80,640L80,560L420,360L420,140Q420,115 437.5,97.5Q455,80 480,80Q505,80 522.5,97.5Q540,115 540,140L540,360L880,560L880,640L540,540L540,760L620,820L620,880L480,840L340,880Z" />
    </group>
</vector>
