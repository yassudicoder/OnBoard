<?xml version="1.0" encoding="utf-8"?>
<!-- Plus Jakarta Sans, the font of the team's Figma design (headings SemiBold 600). Bundled inside the app, so it works
     offline (no downloadable-fonts request). SIL Open Font License 1.1: docs/licenses/PlusJakartaSans-OFL.txt,
     files from github.com/tokotype/PlusJakartaSans (fonts/ttf). Hindi and Marathi letters fall back to the phone's
     own Devanagari font. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/plus_jakarta_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/plus_jakarta_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/plus_jakarta_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/plus_jakarta_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
