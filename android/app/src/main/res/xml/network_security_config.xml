<?xml version="1.0" encoding="utf-8"?>
<!-- Network security for RELEASE builds: HTTPS only. Plain http is blocked everywhere.
     Debug builds use app/src/debug/res/xml/network_security_config.xml instead, which also allows
     http to the laptop running the backend during development. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
