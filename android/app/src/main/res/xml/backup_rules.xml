<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 (API 30) and older (Android 12+ uses data_extraction_rules.xml).
     See https://developer.android.com/guide/topics/data/autobackup for details.

     The app's database holds the traveller's ID details (Aadhaar last 4 digits, PAN, visas), so it is left out of the
     cloud backup. -->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
