<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Safar Saathi colours: Material 3 colour scheme, LIGHT mode.
         Generated with Google's material-color-utilities (the engine behind Material Theme Builder) from
         an aviation-blue seed (#1565C0) with a saffron accent (#FF9933) as the "tertiary" colour.
         values-night/colors.xml has the SAME names with dark-mode values, and Android picks the right
         file automatically. values/themes.xml connects these colours to the theme.
         "on..." colours are for text/icons drawn ON TOP of the colour with the same name. -->

    <!-- Primary: main brand colour (buttons, active states) -->
    <color name="md_theme_primary">#285EA7</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_primaryContainer">#D6E3FF</color>
    <color name="md_theme_onPrimaryContainer">#00468C</color>
    <color name="md_theme_inversePrimary">#A9C7FF</color>

    <!-- Secondary: calmer companion colour (e.g. the selected bottom-bar pill) -->
    <color name="md_theme_secondary">#555F71</color>
    <color name="md_theme_onSecondary">#FFFFFF</color>
    <color name="md_theme_secondaryContainer">#DAE2F9</color>
    <color name="md_theme_onSecondaryContainer">#3E4758</color>

    <!-- Tertiary: saffron accent -->
    <color name="md_theme_tertiary">#8B5012</color>
    <color name="md_theme_onTertiary">#FFFFFF</color>
    <color name="md_theme_tertiaryContainer">#FFDCC2</color>
    <color name="md_theme_onTertiaryContainer">#6D3A00</color>

    <!-- Error -->
    <color name="md_theme_error">#BA1A1A</color>
    <color name="md_theme_onError">#FFFFFF</color>
    <color name="md_theme_errorContainer">#FFDAD6</color>
    <color name="md_theme_onErrorContainer">#93000A</color>

    <!-- Backgrounds and surfaces (screens, bars, cards) -->
    <color name="md_theme_background">#FAF9FD</color>
    <color name="md_theme_onBackground">#1A1B1E</color>
    <color name="md_theme_surface">#FAF9FD</color>
    <color name="md_theme_onSurface">#1A1B1E</color>
    <color name="md_theme_surfaceVariant">#E0E2EC</color>
    <color name="md_theme_onSurfaceVariant">#44474E</color>
    <color name="md_theme_inverseSurface">#2F3033</color>
    <color name="md_theme_inverseOnSurface">#F1F0F4</color>
    <color name="md_theme_surfaceDim">#DAD9DD</color>
    <color name="md_theme_surfaceBright">#FAF9FD</color>
    <color name="md_theme_surfaceContainerLowest">#FFFFFF</color>
    <color name="md_theme_surfaceContainerLow">#F4F3F7</color>
    <color name="md_theme_surfaceContainer">#EFEDF1</color>
    <color name="md_theme_surfaceContainerHigh">#E9E7EC</color>
    <color name="md_theme_surfaceContainerHighest">#E3E2E6</color>

    <!-- Outlines and dividers -->
    <color name="md_theme_outline">#74777F</color>
    <color name="md_theme_outlineVariant">#C4C6CF</color>

    <!-- Trip timeline status colours (status chips and the red "needs your decision" banner).
         "container" = the fill, "on_container" = text/icons drawn on it. Each pair has a contrast ratio of
         at least 7:1 (WCAG AAA), so the chips stay readable in sunlight and for older eyes.
         values-night/colors.xml has the dark-mode pairs under the same names. -->
    <color name="status_ok_container">#C4EED0</color>
    <color name="status_ok_on_container">#00391A</color>
    <color name="status_adjusted_container">#FFDF99</color>
    <color name="status_adjusted_on_container">#3D2B00</color>
    <color name="status_needs_user_container">#A8221B</color>
    <color name="status_needs_user_on_container">#FFFFFF</color>
    <color name="status_done_container">#E3E2E6</color>
    <color name="status_done_on_container">#303033</color>

    <!-- App icon background (same in light and dark mode, so it is only defined here). -->
    <color name="ic_launcher_background">#285EA7</color>
</resources>
