<?xml version="1.0" encoding="utf-8"?>
<!-- The Material 3 type scale in Plus Jakarta Sans (the Figma font). Each style keeps Material's sizes and only
     changes the font and weight; Theme.SafarSaathi (themes.xml) points the textAppearance... attributes here, so every
     screen that uses ?attr/textAppearanceTitleMedium etc. gets the brand font. Weights: headings and titles 600 as
     measured in the Figma; body 400; labels/buttons 500-600. android:textFontWeight needs Android 9+; Android 8 shows
     the regular weight. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="TextAppearance.OnBoard.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">400</item>
    </style>
    <style name="TextAppearance.OnBoard.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">400</item>
    </style>
    <style name="TextAppearance.OnBoard.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">400</item>
    </style>
    <style name="TextAppearance.OnBoard.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>
    <style name="TextAppearance.OnBoard.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>
    <style name="TextAppearance.OnBoard.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>
    <style name="TextAppearance.OnBoard.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>
    <style name="TextAppearance.OnBoard.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
