        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
    </style>
    <style name="TextAppearance.OnBoard.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
