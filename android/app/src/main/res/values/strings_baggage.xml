<?xml version="1.0" encoding="utf-8"?>
<!-- Baggage Shield B3 (Help tab, bag claims, Lost & Found). English only for now; Hindi and Marathi come in phase P.
     Honesty rules (CLAUDE.md): never promise an outcome or an amount, never say "verified", always show the source of a
     rule, and say plainly what the phone could not prove. -->
<resources>
    <!-- What happened? -->
    <string name="help_what_happened">What happened?</string>
    <string name="help_what_happened_intro">Pick what went wrong. OnBoard shows what to do, step by step, and keeps your photos and details on this phone.</string>
    <string name="help_issue_damage">My bag is damaged</string>
    <string name="help_issue_damage_hint">Broken wheel or handle, torn, crushed</string>
    <string name="help_issue_delay">My bag didn\'t arrive</string>
    <string name="help_issue_delay_hint">Not on the belt, or came days later</string>
    <string name="help_issue_pilferage">Something is missing from my bag</string>
    <string name="help_issue_pilferage_hint">The bag arrived, an item didn\'t</string>
    <string name="help_issue_lost">I lost something at the airport</string>
    <string name="help_issue_lost_hint">Left behind in the terminal or on the plane</string>
    <string name="help_not_legal_advice">Information only, not legal advice. The airline decides on any claim.</string>
    <string name="bags_b1_note">Coming in B1: register your bag, scan its tag and photograph it before drop-off with a server-signed receipt. Today: the bag-problem guide below works fully on this phone.</string>

