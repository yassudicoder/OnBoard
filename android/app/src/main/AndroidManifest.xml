<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest tells Android what is inside the app: its permissions, its Application class,
     its screens (activities) and which screen opens from the launcher icon. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app talks to our backend (and later to Google Maps). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Navigate: counting steps to move the blue arrow along the route (Android 10+ asks the traveller first;
         without it the arrow moves with QR codes, "I'm here" or the demo walk only). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Navigate: the notification while walking to the gate ("Gate 32 · 4 min"; Android 13+ asks the traveller first). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Navigate: NavigationService keeps step counting going with the screen off. Type "health" = step counting;
         Android allows it only once the traveller allowed physical activity (above). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- Ride handoff: "is the phone online?", so the ride button can say "Uber needs internet to book". Android grants
         this one without asking. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Ride handoff: since Android 11 an app only "sees" the other apps it names here. We look for the Uber app (to
         say "Opened in Uber" vs "its website") and for browsers (the fallback when Uber is not installed). -->
    <queries>
        <package android:name="com.ubercab" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Ask OnBoard: questions by voice. The microphone is used only while the screen is listening (asked the first
         time the mic button is tapped); the phone's speech service turns the words into text. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Ask OnBoard: since Android 11 an app only "sees" the speech recognizer and the text-to-speech engines when it
         names them here. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Document Vault: the vault's own camera screen (only used when Google's document scanner is not available;
         that scanner uses Play services' camera and needs no permission from us). Asked for the first time it is
         needed. required="false": phones without a camera can still install the app and import PDFs or photos. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- android:name=".SafarSaathiApp" = our own Application class; it runs once when the app process starts.
         networkSecurityConfig = which servers may be reached over plain http (see res/xml/network_security_config.xml). -->
    <application
        android:name=".SafarSaathiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafarSaathi"
        tools:targetApi="31">

        <!-- Google Maps key, filled in at build time from MAPS_API_KEY in android/local.properties
             (empty when there is no key). The Maps SDK reads it from here; used from Phase 7. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Navigate: asks Google Play services to download its QR scanner screen when the app is installed
             (instead of on the first scan). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- The one and only activity. It hosts the five tabs (Home, Trip, Assistant, Wallet, Profile).
             exported="true" + the MAIN/LAUNCHER filter = it opens when you tap the app icon. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.SafarSaathi.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Navigate: runs only while walking with step counting on (see NavigationService). -->
        <service
            android:name=".ui.navigate.NavigationService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Help tab, bag photos: gives the phone's camera app a content:// link to write ONE new photo into the app's
             cache (res/xml/bag_photo_paths.xml). Not exported: only apps we hand a link to can use it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.bagphotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/bag_photo_paths" />
        </provider>
    </application>

</manifest>
