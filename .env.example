# =============================================================================
# Safar Saathi - backend settings and API keys. NAMES ONLY - no real values here.
# =============================================================================
#
# How to use it
#   1. Copy this file to ".env" in the repo ROOT (the folder with docker-compose.yml):
#        macOS / Linux / Git Bash:  cp .env.example .env
#        Windows cmd:               copy .env.example .env
#        Windows PowerShell:        Copy-Item .env.example .env
#   2. Fill in only the keys you have. Every key is optional:
#      leave it empty = that service uses its built-in MOCK (fake data) and the demo still works.
#   3. Restart the backend. http://localhost:8080/api/health then shows MOCK or REAL per service.
#
# .env is git-ignored. NEVER commit it, and never paste keys into code, chats or screenshots.
#
# Who reads .env?
#   - The Spring Boot backend (through spring.config.import), whether you start it from
#     the repo root or from backend/.
#   - docker compose, for DB_NAME / DB_USERNAME / DB_PASSWORD (it reads .env from the repo root).
#   Real environment variables always win over the values in this file.
#
# Format rules (the backend reads this file as a Java ".properties" file):
#   - One NAME=value per line. No quotes around values - quotes would become part of the value.
#   - No spaces after the value, and no comment at the end of a value line
#     (PORT=8081 # mine  would make the whole "8081 # mine" the value).
#   - Windows paths: use forward slashes, e.g. C:/Users/you/keys/firebase-key.json
#     (a backslash is an escape character in this format and would break the path).
#
# Settings that HAVE a default are commented out below (# NAME=default) on purpose.
# An uncommented empty line such as "PORT=" means "set to an empty string", which is not the
# same as "not set": Spring then hands over the empty value instead of using the default.
# Some settings cope with that (docker-compose.yml's ${NAME:-default} does), others may not -
# so keep the "# " until you need a different value. Then remove it and edit the value.
# =============================================================================


# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# APP_MODE - demo or prod. demo = the flight watcher checks every 30 seconds
# (good for live demos); prod = every 5 minutes (saves API quota). Default: demo
# APP_MODE=demo

# PORT - the port the backend listens on. Default: 8080
# If 8080 is busy, use PORT=8081 here AND set BACKEND_BASE_URL=http://10.0.2.2:8081/
# in android/local.properties so the app follows.
# PORT=8080


# -----------------------------------------------------------------------------
# Database - where the backend keeps the trips (needed from Phase 1)
# -----------------------------------------------------------------------------
#
# ONE set of names for both sides: the backend AND docker-compose.yml read DB_NAME,
# DB_USERNAME and DB_PASSWORD, so the two always agree. The defaults are the local Docker
# database, so for local development you change NOTHING here.
#
# a) Local Docker database (the normal case): keep all four lines below commented out.
#    Postgres reads DB_NAME / DB_USERNAME / DB_PASSWORD only when it CREATES the database
#    (the very first "docker compose up"). To change them later, run "docker compose down -v"
#    first (that DELETES the local data), then "docker compose up -d".
#
# b) Hosted Supabase Postgres: in the Supabase dashboard click "Connect" (top of the page) and
#    copy the "Session pooler" connection string. (Skip "Direct connection": it needs IPv6,
#    which many home and college networks don't have.) It looks like this:
#      postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<host>.pooler.supabase.com:5432/postgres
#    Java wants it in pieces: put "jdbc:" in front, leave out the "user:password@" part and add
#    ?sslmode=require at the end (= always encrypt the connection). The user and the password
#    go on their own lines:
#      DB_URL=jdbc:postgresql://<host>.pooler.supabase.com:5432/postgres?sslmode=require
#      DB_USERNAME=postgres.<project-ref>
#      DB_PASSWORD=<your Supabase database password>
#    DB_NAME is not needed for Supabase (it only names the local Docker database). On its first
#    start the backend creates its tables there and loads the demo trips, just like locally.
#    Back to the local database later? Put the "# " back in front of those three lines.
#
# Passwords: use letters and digits only. docker compose and the backend both read this file,
# and they treat some symbols ($ \ # and spaces) differently, so the two could end up with
# different passwords.

# DB_NAME - name of the local Docker database. Default: safarsaathi
# DB_NAME=safarsaathi

# DB_USERNAME - the database user. Default: safarsaathi
# DB_USERNAME=safarsaathi

# DB_PASSWORD - that user's password. Default: safarsaathi (fine for a laptop-only database,
# never for a hosted one)
# DB_PASSWORD=safarsaathi

# DB_URL - where the backend finds the database, as a JDBC URL (Java's address format for
# databases). Default: jdbc:postgresql://localhost:5432/ followed by DB_NAME, which is the
# local Docker database.
# DB_URL=jdbc:postgresql://localhost:5432/safarsaathi


# -----------------------------------------------------------------------------
# AI - Google Gemini: plain-language explanations, translation, chat (built in Phase 6)
# -----------------------------------------------------------------------------

# GEMINI_API_KEY - get one at https://aistudio.google.com/apikey (sign in -> Create API key).
# Leave empty = mock: ready-made template sentences instead of AI text.
GEMINI_API_KEY=

# GEMINI_MODEL - which Gemini model to call. Default: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash


# -----------------------------------------------------------------------------
# Flight status - AeroDataBox on RapidAPI (built in Phase 2)
# -----------------------------------------------------------------------------

# AERODATABOX_API_KEY - your RapidAPI key (the "X-RapidAPI-Key" value).
# Get it: https://rapidapi.com/aedbx-aedbx/api/aerodatabox -> subscribe to a plan
# -> copy X-RapidAPI-Key from the code example on that page.
# Leave empty = mock: flight status that WE control with /api/demo/trigger-delay and trigger-cancel.
AERODATABOX_API_KEY=


# -----------------------------------------------------------------------------
# Directions - Google Routes API, called from the server so the key never ships in the app
# (built in Phase 7)
# -----------------------------------------------------------------------------

# GOOGLE_ROUTES_API_KEY - Google Cloud console (console.cloud.google.com) -> APIs & Services
# -> enable "Routes API" -> Credentials -> Create credentials -> API key.
# Restrict the key to the Routes API. Google Maps Platform needs billing turned on.
# Leave empty = mock: travel time estimated from the distance.
GOOGLE_ROUTES_API_KEY=


# -----------------------------------------------------------------------------
# Push notifications - Firebase Cloud Messaging (built in Phase 3)
# -----------------------------------------------------------------------------

# FIREBASE_CREDENTIALS_PATH - full path to a Firebase SERVICE-ACCOUNT JSON file.
# Get it: console.firebase.google.com -> your project -> Project settings (gear icon)
# -> Service accounts -> Generate new private key.
# That file is a real secret: keep it OUTSIDE the repo, e.g. C:/Users/you/keys/...
# Leave empty, or point to a file that does not exist = mock: no real push is sent.
FIREBASE_CREDENTIALS_PATH=


# -----------------------------------------------------------------------------
# Meetings - Google Calendar (built in Phase 4)
# -----------------------------------------------------------------------------

# GOOGLE_CALENDAR_CREDENTIALS_PATH - full path to a Google OAUTH CLIENT JSON file
# (the client_secret_....json you download). Get it: Google Cloud console -> enable
# "Google Calendar API" -> set up the OAuth consent screen (add yourself as a test user)
# -> Credentials -> Create credentials -> OAuth client ID -> Desktop app -> Download JSON.
# Keep it OUTSIDE the repo.
# Leave empty, or point to a file that does not exist = mock calendar inside the backend.
GOOGLE_CALENDAR_CREDENTIALS_PATH=


# -----------------------------------------------------------------------------
# Voice - Sarvam AI, optional cloud voice for Indian languages (stretch goal)
# -----------------------------------------------------------------------------

# SARVAM_API_KEY - get it at dashboard.sarvam.ai (sign in -> API keys).
# Leave empty = mock: the app sticks to Android's built-in speech recognition and text-to-speech.
SARVAM_API_KEY=


# -----------------------------------------------------------------------------
# Weather - Open-Meteo needs NO key, so it is always REAL. Nothing to set.
# -----------------------------------------------------------------------------
